{
  "name": "ciclovalor-starter",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @ciclovalor/api",
    "build": "npm run build:api && next build --webpack",
    "build:api": "npm run build --workspace @ciclovalor/api",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @ciclovalor/api",
    "test:api": "node --test scripts/api.test.mjs",
    "dev:web": "node scripts/dev.mjs",
    "build:web": "next build --webpack",
    "build:services": "node scripts/build-services.mjs",
    "test:services": "node --test scripts/services.test.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
